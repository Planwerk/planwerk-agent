{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinderOutput",
  "description": "Wire contract for every pass that emits findings (the review, the audit, the adversarial pass, the domain specialists, the feature-compliance check, the simplify finder and the implementation verifier): the JSON each such session emits, passed to the CLI via --json-schema. It mirrors report.ReviewResult minus the Go-derived and pipeline-set fields (id, fix_class, confirmed_by, verification_note, snippet_check, claim_check, and the run-level gates object) such a pass never produces. Every finding carries its severity, actionability and confidence label, each exactly one enum value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "summary", "recommendation"],
  "properties": {
    "findings": {
      "description": "Findings the pass reports. May be null or [] when there are none.",
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": { "type": "string" },
    "recommendation": { "type": "string" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "title", "file", "problem", "action", "actionability", "confidence"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["BLOCKING", "CRITICAL", "WARNING", "INFO"]
        },
        "title": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "line_end": { "type": "integer" },
        "pattern": { "type": "string" },
        "actionability": {
          "type": "string",
          "enum": ["auto-fix", "needs-discussion", "architectural"]
        },
        "confidence": {
          "type": "string",
          "enum": ["verified", "likely", "uncertain"]
        },
        "problem": { "type": "string" },
        "action": { "type": "string" },
        "code_snippet": { "type": "string" },
        "suggested_fix": { "type": "string" },
        "fix_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixOption" }
        },
        "recommended_option": { "type": "string" },
        "recommendation_reasoning": { "type": "string" },
        "related_to": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fixOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "approach"],
      "properties": {
        "id": { "type": "string" },
        "approach": { "type": "string" },
        "pros": { "type": "string" },
        "cons": { "type": "string" },
        "effort": { "type": "string" },
        "risk_if_skipped": { "type": "string" }
      }
    }
  }
}
